{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nshxgolruvisdzptcxew.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "betwise-mcp",
      "version": "0.2.0",
      "title": "Betwise Sportsbook"
    },
    "tools": [
      {
        "name": "list_fixtures",
        "title": "List fixtures",
        "description": "List Betwise football fixtures by status (upcoming, live, finished). Returns up to 25.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Fixture status (default upcoming).",
              "type": "string",
              "enum": [
                "upcoming",
                "live",
                "finished"
              ]
            },
            "limit": {
              "description": "Max rows (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_wallet",
        "title": "Get my wallet balance",
        "description": "Get the signed-in user's Betwise wallet balance in KES.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_bet_slips",
        "title": "List my bet slips",
        "description": "List the signed-in user's most recent Betwise bet slips.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
